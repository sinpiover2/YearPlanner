# Server-only Netlify Function values. Never prefix either value with VITE_,
# because Vite exposes those variables to the browser bundle.
#
# PLANNING_WRITE_TOKEN must exactly match the WRITE_TOKEN Script Property in
# apps-script-planning. Generate the production replacement during the
# separately approved credential-rotation step.
PLANNING_WRITE_TOKEN=

# Exact Google-account email invited to Netlify Identity.
PLANNING_TEACHER_EMAIL=
